---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import BuyButton from '../../components/BuyButton.astro';
import Footer from '../../components/Footer.astro';
import { products, getRelatedProducts, type Product } from '../../data/products';
import { whatsAppGeneral } from '../../data/site.config';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const relatedProducts = getRelatedProducts(product.id, 4);
const waUrl = whatsAppGeneral();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Badge usa só o primeiro segmento da categoria
const badgeLabel = product.category.split('/')[0].trim();

// Monta lista de specs (filtra os nulos)
const specItems = [
  { label: 'Conteúdo',       value: product.specs.contents },
  { label: 'Quantidade',     value: product.specs.sampleCount },
  { label: 'Formato',        value: product.specs.format },
  { label: 'Resolução',      value: product.specs.resolution },
  { label: 'Compatibilidade',value: product.specs.compatibility },
  { label: 'Tamanho',        value: product.specs.fileSize },
  { label: 'Licença',        value: product.specs.license },
  ...(product.specs.requirements
    ? [{ label: 'Requisitos', value: product.specs.requirements }]
    : []),
].filter((s) => s.value !== null && s.value !== undefined && s.value !== '');
---

<BaseLayout
  title={`WaveNoise Lab — ${product.name}`}
  description={product.description ?? 'Sample pack de bateria e percussão desenvolvidos com propósito. Qualidade de estúdio.'}
  ogImage={product.coverImage ?? `${base}/favicon.svg`}
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 flex flex-col gap-20">

    <!-- ═══ PRODUTO PRINCIPAL ═══════════════════════════════ -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

      <!-- Capa -->
      <div
        class="overflow-hidden"
        style="border-radius:24px;border:1px solid rgba(255,255,255,0.08);aspect-ratio:1"
      >
        {product.coverImage ? (
          <img
            src={product.coverImage}
            alt={`Capa de ${product.name}`}
            class="w-full h-full object-cover"
            loading="eager"
          />
        ) : (
          <div
            class="w-full h-full flex flex-col justify-between p-6"
            style="background:repeating-linear-gradient(135deg,rgba(242,237,228,0.04) 0 10px,transparent 10px 24px),#1b1917"
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] tracking-widest uppercase text-chassis bg-accent px-2.5 py-1 rounded-full">
                {badgeLabel}
              </span>
              <span class="font-mono text-[11px] text-text-muted/40">WNL</span>
            </div>
            <div class="text-center">
              <p class="font-mono text-xs text-text-muted/50 uppercase tracking-widest mb-2">{product.category}</p>
              <h2 class="font-heading font-bold text-2xl text-text-main">{product.name}</h2>
            </div>
            <p class="font-mono text-[11px] text-text-muted/40 uppercase tracking-widest text-center">Arte em produção</p>
          </div>
        )}
      </div>

      <!-- Informações e compra -->
      <div class="flex flex-col gap-6">
        <div>
          <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">{product.category}</p>
          <h1
            class="font-heading font-extrabold text-text-main leading-tight mb-4"
            style="font-size:clamp(36px,5vw,64px);letter-spacing:-0.03em"
          >
            {product.name}
          </h1>
          {product.tagline && (
            <p class="text-text-main text-lg font-medium leading-relaxed mb-3">{product.tagline}</p>
          )}
          {product.description && (
            <p class="text-text-muted leading-relaxed" style="text-wrap:pretty">{product.description}</p>
          )}
        </div>

        <div class="pt-6" style="border-top:1px solid rgba(197, 211, 9, 0.08)">
          <BuyButton
            isFree={product.isFree}
            price={product.price}
            originalPrice={product.originalPrice}
            ctaLabel={product.ctaLabel}
            checkoutUrl={product.checkoutUrl}
            productName={product.name}
          />
        </div>
      </div>
    </section>

    <!-- ═══ VÍDEO DE DEMONSTRAÇÃO ════════════════════════════ -->
    {product.youtubeVideoId && (
      <section>
        <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">Demonstração</p>
        <h2
          class="font-heading font-bold text-text-main mb-7"
          style="font-size:clamp(24px,3vw,38px);letter-spacing:-0.02em"
        >
          Veja o pack aplicado num contexto musical
        </h2>
        <div style="border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.08)">
          <YouTubeEmbed
            videoId={product.youtubeVideoId}
            title={product.name}
            aspectRatio={product.youtubeAspectRatio}
          />
        </div>
      </section>
    )}

    <!-- ═══ ESPECIFICAÇÕES ════════════════════════════════════ -->
    {specItems.length > 0 && (
      <section>
        <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">Detalhes Técnicos</p>
        <h2
          class="font-heading font-bold text-text-main mb-7"
          style="font-size:clamp(24px,3vw,38px);letter-spacing:-0.02em"
        >
          ESPECIFICAÇÕES DO PACK
        </h2>
        <div
          class="overflow-hidden grid grid-cols-1 sm:grid-cols-2"
          style="background:#1b1917;border:1px solid rgba(255,255,255,0.08);border-radius:20px"
        >
          {specItems.map((s) => (
            <div
              class="flex flex-col gap-1.5 p-5"
              style="border-bottom:1px solid rgba(255,255,255,0.08);border-right:1px solid rgba(255,255,255,0.08)"
            >
              <span class="font-mono text-[11px] uppercase tracking-widest text-text-muted">{s.label}</span>
              <span class="text-text-main font-medium">{s.value}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ═══ PRODUTOS RELACIONADOS ════════════════════════════ -->
    {relatedProducts.length > 0 && (
      <section>
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <h2 class="font-heading font-bold text-xl text-text-main">Mais Packs da WaveNoise Lab</h2>
          <a href={`${base}/`} class="font-mono text-xs text-text-muted hover:text-text-main transition">
            ver catálogo →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedProducts.map((rel) => (
            <a
              href={`${base}/products/${rel.slug}/`}
              class="flex items-center gap-3 p-4 rounded-2xl transition hover:opacity-90"
              style="background:#1b1917;border:1px solid rgba(255,255,255,0.08)"
            >
              <!-- Mini capa -->
              <span
                class="w-14 h-14 rounded-xl flex-shrink-0 overflow-hidden flex items-center justify-center"
                style="background:#121110;border:1px solid rgba(255,255,255,0.06)"
              >
                {rel.coverImage ? (
                  <img src={rel.coverImage} alt={rel.name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <span class="font-mono text-[8px] text-text-muted/40 text-center px-1">WNL</span>
                )}
              </span>
              <!-- Info -->
              <span class="flex flex-col gap-0.5 min-w-0">
                <span class="font-heading font-bold text-sm text-text-main truncate">{rel.name}</span>
                <span class="font-mono text-[10px] text-text-muted uppercase truncate">
                  {rel.category.split('/')[0].trim()}
                </span>
                <span class="font-mono text-xs text-accent font-medium">
                  {rel.isFree ? 'FREE' : rel.price ? `R$ ${rel.price}` : 'Em breve'}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ═══ CTA WHATSAPP ═════════════════════════════════════ -->
    <section>
      <div
        class="p-8 flex flex-col sm:flex-row justify-between items-center gap-6"
        style="background:#1b1917;border:1px solid rgba(255,255,255,0.08);border-radius:24px"
      >
        <div>
          <p class="font-mono text-xs text-text-muted uppercase tracking-widest mb-2">Ficou com dúvida?</p>
          <h3 class="font-heading font-bold text-xl text-text-main">Fale direto no WhatsApp.</h3>
        </div>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-sm px-6 py-3.5 rounded-full bg-accent text-chassis hover:opacity-90 transition whitespace-nowrap flex-shrink-0"
        >
          Abrir WhatsApp →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
