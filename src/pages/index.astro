---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';
import { whatsAppGeneral } from '../data/site.config';

const waUrl = whatsAppGeneral();
const freeProduct = products.find((p) => p.isFree);
---

<BaseLayout
  title="WaveNoise Lab — Samples de Bateria Gravados em Estúdio"
  description="Samples de bateria e percussão gravados com instrumentos reais para bateristas, produtores e músicos. Rock, Metal, Worship, Vintage e 80s."
>
  <Header />

  <main class="flex-1 overflow-x-hidden">

    <!-- ═══ HERO ═══════════════════════════════════════════ -->
    <section class="relative max-w-6xl mx-auto px-6 pt-20 pb-14">
      <!-- Brilho radial decorativo (do dc.html) -->
      <div
        class="absolute pointer-events-none"
        style="top:0;right:0;width:60vw;max-width:720px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle, oklch(0.82 0.16 80 / 0.15), transparent 60%);transform:translate(30%, -40%)"
      ></div>

      <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-5 animate-rise">
        100% WAV · Gravado em Estúdio · Bateria & Percussão
      </p>

      <h1
        class="font-heading font-extrabold text-text-main leading-[0.95] tracking-tight mb-8 animate-rise-2"
        style="font-size:clamp(44px,8vw,100px);max-width:14ch;text-wrap:balance"
      >
        Samples de estúdio para quem cria de verdade.
      </h1>

      <div class="flex gap-8 flex-wrap items-end animate-rise-3">
        <p
          class="text-text-muted leading-relaxed max-w-xl"
          style="font-size:clamp(16px,1.5vw,20px);text-wrap:pretty"
        >
          Kits de bateria, pads e percussão gravados com instrumentos reais — Rock, Metal,
          Worship, Vintage e 80s. Você escolhe o pack e monta o som que é só seu.
        </p>
        <div class="flex gap-3 flex-wrap">
          <a
            href="#catalogo"
            class="font-semibold text-sm px-6 py-3.5 rounded-full bg-text-main text-chassis hover:opacity-90 active:scale-[0.98] transition"
          >
            Explorar Packs
          </a>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-sm px-6 py-3.5 rounded-full transition"
            style="border:1px solid rgba(255,255,255,0.2);color:#f2ede4"
          >
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ GRID DE PRODUTOS ════════════════════════════════ -->
    <section id="catalogo" class="max-w-6xl mx-auto px-6 py-10">
      <div class="flex justify-between items-baseline gap-4 flex-wrap mb-7">
        <h2
          class="font-heading font-bold text-text-main"
          style="font-size:clamp(26px,3vw,38px);letter-spacing:-0.02em"
        >
          Sample Packs
        </h2>
        {freeProduct && (
          <a
            href={`/products/${freeProduct.slug}`}
            class="font-mono text-xs text-text-muted hover:text-text-main transition"
          >
            pack gratuito disponível →
          </a>
        )}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>

    <!-- ═══ COMO FUNCIONA ════════════════════════════════════ -->
    <section style="border-top:1px solid rgba(255,255,255,0.08);border-bottom:1px solid rgba(255,255,255,0.08);background:#161412">
      <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 sm:grid-cols-3 gap-12">
        <div>
          <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">01 — Escolha</p>
          <h3 class="font-heading font-bold text-2xl text-text-main mb-3">Encontre seu universo sonoro</h3>
          <p class="text-text-muted text-sm leading-relaxed text-wrap-pretty">
            Rock, Metal, Worship, Vintage ou 80s — cada pack nasce de um estilo.
            Explore o catálogo e assista ao vídeo de demonstração antes de decidir.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">02 — Compre</p>
          <h3 class="font-heading font-bold text-2xl text-text-main mb-3">Processo direto pelo WhatsApp</h3>
          <p class="text-text-muted text-sm leading-relaxed text-wrap-pretty">
            Clique em comprar e você vai para o WhatsApp com o pedido já preenchido.
            Confirmamos o pagamento e enviamos o link de download em até 24h.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs tracking-[0.14em] uppercase text-accent mb-3">03 — Use</p>
          <h3 class="font-heading font-bold text-2xl text-text-main mb-3">WAV. Qualquer DAW ou pad.</h3>
          <p class="text-text-muted text-sm leading-relaxed text-wrap-pretty">
            Todos os arquivos são WAV — prontos para Ableton, FL Studio, Logic, Pro Tools,
            GarageBand, MPC e qualquer módulo eletrônico.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ DESTAQUE FREE PACK ══════════════════════════════ -->
    {freeProduct && (
      <section class="max-w-6xl mx-auto px-6 py-16">
        <div
          class="p-10 flex justify-between items-center gap-8 flex-wrap"
          style="background:#1b1917;border:1px solid rgba(255,255,255,0.08);border-radius:24px"
        >
          <div>
            <span
              class="font-mono text-[11px] tracking-widest uppercase text-accent px-3 py-1 rounded-full inline-block mb-5"
              style="border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05)"
            >
              GRÁTIS · PORTA DE ENTRADA
            </span>
            <h2
              class="font-heading font-bold text-text-main mb-3"
              style="font-size:clamp(24px,3vw,38px);letter-spacing:-0.02em"
            >
              {freeProduct.name}
            </h2>
            <p class="text-text-muted text-sm max-w-lg leading-relaxed">
              {freeProduct.description ?? 'Experimente a sonoridade da WaveNoise Lab sem precisar de cadastro ou cartão.'}
            </p>
          </div>
          <a
            href={`/products/${freeProduct.slug}`}
            class="font-semibold text-sm px-6 py-3.5 rounded-full bg-text-main text-chassis hover:opacity-90 transition whitespace-nowrap flex-shrink-0"
          >
            Baixar Grátis →
          </a>
        </div>
      </section>
    )}

    <!-- ═══ CTA WHATSAPP ════════════════════════════════════ -->
    <section class="max-w-6xl mx-auto px-6 pb-20">
      <div
        class="px-10 py-14 flex justify-between items-center gap-8 flex-wrap bg-accent"
        style="border-radius:28px"
      >
        <h2
          class="font-heading font-extrabold text-chassis leading-tight"
          style="font-size:clamp(28px,4vw,52px);max-width:18ch;letter-spacing:-0.03em;line-height:1"
        >
          Dúvida sobre qual pack combina com você?
        </h2>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-sm px-7 py-4 rounded-full bg-chassis text-text-main hover:bg-text-main hover:text-chassis transition whitespace-nowrap flex-shrink-0"
        >
          Falar no WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
