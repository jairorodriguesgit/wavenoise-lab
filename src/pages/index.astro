---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';

// Identifica o produto gratuito para o destaque dedicado
const freeProduct = products.find((p) => p.isFree);
---

<BaseLayout
  title="WaveNoise Lab — Recursos Sonoros & Samples de Bateria"
  description="Laboratório sonoro focado em bateria, produção musical e identidade. Samples para bateristas, produtores e músicos."
>
  <Header />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 w-full flex flex-col gap-16 sm:gap-20">
    <!-- 1. Hero Compacto e Direto -->
    <section class="flex flex-col gap-5 max-w-3xl">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent inline-block" />
        <span class="font-mono text-xs uppercase tracking-widest text-text-muted">
          RECURSOS SONOROS & SAMPLES DE BATERIA
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-text-main uppercase leading-tight">
        Laboratório sonoro focado em bateria, produção musical e identidade.
      </h1>

      <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl">
        Amostras e timbres gravados e processados para uso imediato em produções musicais, DAWs e pads eletrônicos. Sem ruído de marketing: som direto ao ponto.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="#catalogo"
          class="h-11 px-6 bg-text-main text-chassis font-bold text-xs uppercase tracking-wider rounded-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center cursor-pointer"
        >
          Explorar Packs
        </a>

        {
          freeProduct && (
            <a
              href={`/products/${freeProduct.slug}`}
              class="h-11 px-6 border border-border bg-surface text-text-main font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-surface-hover active:scale-[0.98] transition flex items-center gap-2 cursor-pointer"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block" />
              Experimentar Free Pack
            </a>
          )
        }
      </div>
    </section>

    <!-- 2. Destaque Especial: Free Pack (Hardware Rack Unit) -->
    {
      freeProduct && (
        <section class="border border-border bg-surface rounded-sm p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden">
          <div class="flex flex-col gap-2 max-w-xl">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] text-accent uppercase tracking-widest px-2 py-0.5 border border-accent/40 bg-accent/10 rounded-sm">
                PORTA DE ENTRADA • FREE
              </span>
              <span class="font-mono text-[10px] text-text-muted uppercase">
                {freeProduct.category}
              </span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text-main uppercase">
              {freeProduct.name}
            </h2>

            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
              {freeProduct.description} Experimente a sonoridade e dinâmica da WaveNoise Lab sem precisar de cadastro ou cartão.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row md:flex-col items-start md:items-end gap-3 w-full md:w-auto shrink-0">
            <div class="font-mono text-xl font-bold text-text-main">
              FREE
            </div>
            <a
              href={`/products/${freeProduct.slug}`}
              class="h-11 px-6 bg-text-main text-chassis font-bold text-xs uppercase tracking-wider rounded-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center w-full sm:w-auto text-center cursor-pointer"
            >
              Acessar Pack Grátis &rarr;
            </a>
          </div>
        </section>
      )
    }

    <!-- 3. Grid Principal de Produtos -->
    <section id="catalogo" class="flex flex-col gap-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-border pb-4 gap-2">
        <div class="flex items-center gap-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text-main uppercase">
            Catálogo de Packs
          </h2>
          <span class="font-mono text-xs text-text-muted">
            ({products.length} PACKS)
          </span>
        </div>
        <span class="font-mono text-[11px] text-text-muted uppercase tracking-wider">
          PADRÃO: WAV 24-BIT • FORMATOS PROFISSIONAIS
        </span>
      </div>

      <!-- Grid Responsivo: 1 col (mobile), 2 cols (tablet), 3 cols (desktop) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
