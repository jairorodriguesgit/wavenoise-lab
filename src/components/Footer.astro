---
import { siteConfig } from '../data/site.config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer style="border-top:1px solid rgba(255,255,255,0.08)" class="mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">

    <!-- Marca -->
    <div class="flex flex-col gap-2">
      <span class="font-heading font-extrabold tracking-widest text-sm text-text-main">WAVENOISE LAB</span>
      <p class="font-mono text-xs text-text-muted max-w-xs leading-relaxed">
        Samples com propósito. Seu som com personalidade.
      </p>
    </div>

    <!-- Links -->
    <nav class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-xs text-text-muted">
      <a href={`${base}/`} class="hover:text-text-main transition">HOME</a>
      <a href={siteConfig.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-text-main transition">YOUTUBE</a>
      <a href={`https://instagram.com/${siteConfig.instagram}`} target="_blank" rel="noopener noreferrer" class="hover:text-text-main transition">INSTAGRAM</a>
      <a href={`${base}/about`} class="hover:text-text-main transition">SOBRE</a>
      <!-- <a href={`${base}/faq`} class="hover:text-text-main transition">FAQ</a> -->
      <!-- <a href={`${base}/contact`} class="hover:text-text-main transition">CONTATO</a> -->
      <a href={`${base}/terms`} class="hover:text-text-main transition">TERMOS</a> 
      <a href={`${base}/privacy`} class="hover:text-text-main transition">PRIVACIDADE</a>
    </nav>
  </div>

  <!-- Barra de copyright -->
  <div
    class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between font-mono text-xs"
    style="border-top:1px solid rgba(255,255,255,0.06);color:rgba(163,158,148,0.6)"
  >
    <span>© 2026 WAVENOISE LAB</span>
    <span>TODOS OS DIREITOS RESERVADOS</span>
  </div>
</footer>
