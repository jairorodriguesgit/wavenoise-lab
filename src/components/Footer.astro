---
// Rodapé institucional simples e minimalista para o WaveNoise Lab
---

<footer class="border-t border-border py-12 mt-16 bg-chassis text-text-muted font-mono text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
    <!-- Marca e Declaração -->
    <div class="flex flex-col gap-2">
      <span class="font-bold text-sm tracking-widest uppercase text-text-main font-sans">
        WAVENOISE LAB
      </span>
      <p class="text-[11px] text-text-muted/80 max-w-xs">
        Recursos sonoros e samples de bateria para produtores e músicos.
      </p>
    </div>

    <!-- Links de Navegação e Comunidade -->
    <div class="flex flex-wrap items-center gap-6 text-xs">
      <a
        href="/"
        class="hover:text-text-main transition"
      >
        HOME
      </a>
      <a
        href="https://youtube.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-text-main transition"
      >
        YOUTUBE
      </a>
      <a
        href="/about"
        class="hover:text-text-main transition"
      >
        SOBRE
      </a>
      <a
        href="/terms"
        class="hover:text-text-main transition"
      >
        TERMOS
      </a>
      <a
        href="/privacy"
        class="hover:text-text-main transition"
      >
        PRIVACIDADE
      </a>
    </div>
  </div>

  <!-- Barra de Direitos Autorais -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 mt-8 border-t border-border/40 flex flex-col sm:flex-row items-center justify-between text-[11px] text-text-muted/60 gap-2">
    <div>&copy; 2026 WAVENOISE LAB — TODOS OS DIREITOS RESERVADOS.</div>
    <div>DESIGN SYSTEM • SSG</div>
  </div>
</footer>

