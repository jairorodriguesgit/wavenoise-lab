---
import { whatsAppGeneral } from '../data/site.config';

const waUrl = whatsAppGeneral();
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<header
  style="position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);background:rgba(18,17,16,0.82);border-bottom:1px solid rgba(255,255,255,0.08)"
>
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between gap-4 flex-wrap">

    <!-- Logo -->
    <a href={base} class="flex items-center gap-2.5 hover:opacity-80 transition">
  <img
    src={`${base}logo-wnl.svg`}
    alt="WaveNoise Lab"
    class="w-8 h-8 object-contain flex-shrink-0"
  />
  <span class="font-heading font-extrabold text-text-main tracking-widest text-sm">
    WAVENOISE LAB
  </span>
</a>

    <!-- Navegação -->
    <nav class="flex items-center gap-1 flex-wrap">
      <a
        href={base}
        class:list={['text-sm px-3 py-2 rounded-full transition', currentPath === base ? 'text-text-main' : 'text-text-muted hover:text-text-main hover:bg-white/5']}
      >
        Samples
      </a>
      <a
        href={`${base}products/free-altar-vibes-worship-fx`}
        class:list={['text-sm px-3 py-2 rounded-full transition', currentPath.includes('free-altar') ? 'text-text-main' : 'text-text-muted hover:text-text-main hover:bg-white/5']}
      >
        Free
      </a>
      <a
        href={`${base}about`}
        class:list={['text-sm px-3 py-2 rounded-full transition', currentPath === '/about' ? 'text-text-main' : 'text-text-muted hover:text-text-main hover:bg-white/5']}
      >
        Sobre
      </a>
     
     <!-- Botão FAQ 
       <a
        href="/faq"
        class:list={['text-sm px-3 py-2 rounded-full transition', currentPath === '/faq' ? 'text-text-main' : 'text-text-muted hover:text-text-main hover:bg-white/5']}
      >
      
        FAQ
      </a>
      <a
        href={`${base}contact`}
        class:list={['text-sm px-3 py-2 rounded-full transition', currentPath === '/contact' ? 'text-text-main' : 'text-text-muted hover:text-text-main hover:bg-white/5']}
      >
        Contato
      </a> -->

      <!-- Botão WhatsApp destacado -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-chassis font-semibold text-sm px-4 py-2 rounded-full ml-2 hover:opacity-90 transition"
      >
        WhatsApp
      </a>
    </nav>
  </div>
</header>
