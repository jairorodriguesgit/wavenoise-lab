---
interface Props {
  isFree: boolean;
  price: number | null;
  originalPrice?: number | null;
  ctaLabel?: string | null;
  checkoutUrl?: string | null;
}

const { isFree, price, originalPrice, ctaLabel, checkoutUrl } = Astro.props;

// Formatação do preço em Real (quando existir número)
const formattedPrice =
  typeof price === 'number'
    ? price === 0
      ? 'FREE'
      : new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL',
        }).format(price)
    : null;

const formattedOriginalPrice =
  typeof originalPrice === 'number'
    ? new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL',
      }).format(originalPrice)
    : null;
---

<div class="flex flex-col gap-3 w-full">
  <!-- Área de Exibição do Preço -->
  <div class="flex items-baseline gap-3">
    {
      isFree ? (
        <div class="flex items-center gap-2">
          <span class="font-mono text-xl sm:text-2xl font-bold text-text-main tracking-tight">
            FREE
          </span>
          <span class="px-2 py-0.5 border border-accent/40 bg-accent/10 text-accent font-mono text-[10px] uppercase tracking-wider rounded-sm">
            Acesso Livre
          </span>
        </div>
      ) : price !== null ? (
        <div class="flex items-baseline gap-2">
          <span class="font-mono text-xl sm:text-2xl font-bold text-text-main tracking-tight">
            {formattedPrice}
          </span>
          {formattedOriginalPrice && (
            <span class="font-mono text-xs text-text-muted line-through">
              {formattedOriginalPrice}
            </span>
          )}
        </div>
      ) : (
        <div class="flex items-center gap-2">
          <span class="font-mono text-sm sm:text-base font-semibold text-text-muted uppercase tracking-wider">
            PREÇO EM BREVE
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-text-muted/60 inline-block" />
        </div>
      )
    }
  </div>

  <!-- Botão de Ação -->
  {
    isFree ? (
      checkoutUrl ? (
        <a
          href={checkoutUrl}
          class="h-12 px-6 bg-text-main text-chassis font-bold text-xs uppercase tracking-wider rounded-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center text-center cursor-pointer"
        >
          {ctaLabel || 'DOWNLOAD GRÁTIS'}
        </a>
      ) : (
        <button
          type="button"
          class="h-12 px-6 bg-text-main text-chassis font-bold text-xs uppercase tracking-wider rounded-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center text-center cursor-pointer"
        >
          {ctaLabel || 'DOWNLOAD GRÁTIS'}
        </button>
      )
    ) : checkoutUrl ? (
      <a
        href={checkoutUrl}
        class="h-12 px-6 bg-text-main text-chassis font-bold text-xs uppercase tracking-wider rounded-sm hover:opacity-90 active:scale-[0.98] transition flex items-center justify-center text-center cursor-pointer"
      >
        {ctaLabel || 'COMPRAR PACK'}
      </a>
    ) : (
      <button
        type="button"
        disabled
        class="h-12 px-6 border border-border bg-surface text-text-muted font-mono font-bold text-xs uppercase tracking-wider rounded-sm cursor-not-allowed opacity-60 flex items-center justify-center text-center"
      >
        EM BREVE
      </button>
    )
  }
</div>
