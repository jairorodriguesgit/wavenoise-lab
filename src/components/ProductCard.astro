---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const formattedPrice =
  typeof product.price === 'number' && product.price > 0
    ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(product.price)
    : null;

// Pega só o primeiro segmento da categoria para o badge (ex: "FREE" de "FREE / WORSHIP / FX")
const badgeLabel = product.category.split('/')[0].trim();
---

<a
  href={`/products/${product.slug}`}
  class="group flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1"
  style="background:#1b1917;border:1px solid rgba(255,255,255,0.08);border-radius:20px"
>
  <!-- Capa 4:3 -->
  <div class="relative overflow-hidden" style="aspect-ratio:4/3">
    {product.coverImage ? (
      <img
        src={product.coverImage}
        alt={`Capa de ${product.name}`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <div
        class="w-full h-full flex items-center justify-center"
        style="background:repeating-linear-gradient(135deg,rgba(242,237,228,0.04) 0 10px,transparent 10px 24px),#1b1917"
      >
        <span class="font-mono text-xs text-text-muted/40">[ capa em produção ]</span>
      </div>
    )}

    <!-- Badge categoria -->
    <span
      class="absolute left-4 top-4 font-mono text-[11px] tracking-widest uppercase text-chassis bg-accent px-2.5 py-1 rounded-full"
    >
      {badgeLabel}
    </span>

    <!-- Badge FREE -->
    {product.isFree && (
      <span
        class="absolute right-4 top-4 font-mono text-[11px] tracking-widest uppercase text-accent px-2.5 py-1 rounded-full"
        style="border:1px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.08)"
      >
        FREE
      </span>
    )}
  </div>

  <!-- Informações -->
  <div class="p-5 flex flex-col gap-3 flex-1">
    <div>
      <h3 class="font-heading font-bold text-xl text-text-main mb-1 leading-tight">
        {product.name}
      </h3>
      {product.tagline && (
        <p class="text-text-muted text-sm leading-snug">{product.tagline}</p>
      )}
    </div>

    <!-- Preço + CTA -->
    <div
      class="flex items-center justify-between mt-auto pt-3 gap-3"
      style="border-top:1px solid rgba(255,255,255,0.08)"
    >
      <span class="font-mono text-xs text-text-muted">
        {product.isFree
          ? 'Acesso livre'
          : product.price !== null && product.price !== undefined && product.price > 0
            ? formattedPrice
            : 'Em breve'}
      </span>
      <span
        class="font-mono text-xs px-3 py-1.5 rounded-full transition group-hover:bg-text-main group-hover:text-chassis"
        style="border:1px solid rgba(255,255,255,0.18);color:#ffa600"
      >
        Ver pack
      </span>
    </div>
  </div>
</a>
